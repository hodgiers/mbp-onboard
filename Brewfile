# ==========================================================================
# CLI: shell & terminal quality-of-life
# ==========================================================================
# Shell extension to jump to frequently used directories
brew "autojump"
# GNU File, Shell, and Text utilities (gls for the lsize alias)
brew "coreutils"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Load/unload environment variables based on $PWD
brew "direnv"
# Isolated development environments using Docker (oh-my-zsh docker-compose plugin)
brew "docker-compose"
# Modern, maintained replacement for ls
brew "eza"
# Render markdown on the CLI
brew "glow"
# Official tldr client written in Rust
brew "tlrc"
# Command-line interface to the freedesktop.org trashcan
# (left unlinked on purpose: linked, `trash` shadows macOS /usr/bin/trash and files skip Finder's Trash)
brew "trash-cli"

